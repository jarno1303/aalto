# Aalto repository line-ending policy

* text=auto

# Source/config files: canonical LF in Git
*.kt          text eol=lf
*.kts         text eol=lf
*.xml         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.properties  text eol=lf
*.rules       text eol=lf

# Gradle wrapper
gradlew       text eol=lf
*.bat         text eol=crlf

# Binary files
*.jar         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
